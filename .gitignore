# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Generated database (built from source data, not committed)
data/medtempo.db

# Pilot artifacts (regenerable via scripts/run_pilot.py; not committed)
data/pilot/

# Whole-population diagnostic: the ~270MB instances file is regenerable
# (scripts/run_pilot.py --full); keep the small reports under data/pilot_full/.
data/pilot_full/instances.jsonl
data/pilot_full_run.log

# Temporary exploration and investigation scripts
inspect*.py
investigate_*.py

# Uploaded zip files and extraction temp dirs
*.zip
_zip_extract/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Release: raw JSONL regenerable (scripts/run_pilot.py --out data/release/v1);
# the committed artifact is the .gz pair plus the reports and statistics.
data/release/*/pilot_instances_questions.jsonl
data/release/*/pilot_instances_answers.jsonl
